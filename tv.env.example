# Keep this file private after copying it to tv.env. Match FRAME_TOKEN in .env.
FRAME_URL=http://YOUR_COMPUTER_LAN_IP:28471/v1/frame
FRAME_TOKEN=replace-with-the-same-long-random-token-as-in-.env

# Set this to the foreground app if known; unknown is safer than a wrong ID.
TV_APP=unknown
TV_ID=frame-tv

# Optional visual treatment. AD_BACKLIGHT is on the tested TV's 0-50 scale.
AD_OVERLAY=1
AD_BACKLIGHT=5

# First run stops after 15 minutes, with a bounded extension during a mute.
# Set to 0 only after you have verified the fail-safe behavior on your TV.
MAX_RUNTIME_SECONDS=900
