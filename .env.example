# Use a long random value. Copy this file to .env and fill in the values.
FRAME_TOKEN=replace-with-a-long-random-token

# Set BIND_IP to your Mac's LAN address for direct TV -> Docker traffic.
# Keep 127.0.0.1 when testing from the Mac only.
BIND_IP=127.0.0.1
PORT=28471

# Host-side Claude Code bridge. Use a second, different random token.
# When unavailable, the TV stays unmuted.
VISION_SERVICE_URL=http://host.docker.internal:8787/classify
VISION_SERVICE_TOKEN=replace-with-another-long-random-token
