# Use a long random value. Copy this file to .env and fill in the values.
FRAME_TOKEN=replace-with-a-long-random-token

# Set BIND_IP to your computer's LAN address for direct TV -> Docker traffic.
# Keep 127.0.0.1 when testing from the computer only.
BIND_IP=127.0.0.1
PORT=28471

# Host-side Claude Code bridge. Use a second, different random token.
# When unavailable, the TV stays unmuted.
VISION_SERVICE_URL=http://host.docker.internal:8787/classify
VISION_SERVICE_TOKEN=replace-with-another-long-random-token

# Idle gap (seconds, 1-5) the TV helper sleeps after an uncovered screenshot.
# 1 gives the fastest ad onset; each extra second cuts classifications per hour.
PROGRAM_IDLE_SECONDS=1

# Idle gap (seconds) between covered screenshots when the TV uses the
# content-recognition capture backend (CAPTURE_BACKEND=acr in tv.env).
# Each covered screenshot briefly blanks the panel; 4 is a reasonable balance.
COVERED_IDLE_ACR_SECONDS=4

# YouTube TV inserted-ad notices from youtube_events.py:
#   off     ignore them
#   shadow  log what they would have done next to the vision verdict
#   active  cover on a validated notice without waiting for the model
NATIVE_ONSET_MODE=shadow

# TV address, used only by the optional native-event relay (start-native.sh).
TV_HOST=YOUR_TV_LAN_IP
